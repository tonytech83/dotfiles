{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fedora/branding/deathstar.txt",
    "color": { "1": "bright_black", "2": "white" },
    "padding": {
      "top": 2,
      "right": 2,
      "left": 2,
    },
  },
  "display": {
    "separator": " ➜  ",
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{#90}┌─────────────────────── {#3}{#1}{#green}Hardware{#}{#90} ─────────────────────────┐",
    },
    {
      "type": "host",
      "key": "{#90}│{#}{#green}   Station  ",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "{#90}│{#}{#green}  CPU       ",
      "showPeCoreCount": true,
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "{#90}│{#}{#green}  GPU       ",
      "detectionMethod": "pci",
      "keyColor": "green",
    },
    {
      "type": "display",
      "key": "{#90}│{#}{#green} 󱄄 Display   ",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": "{#90}│{#}{#green} 󰋊 Disk      ",
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "{#90}│{#}{#green}  Memory    ",
      "keyColor": "green",
    },
    {
      "type": "swap",
      "key": "{#90}│{#}{#green} 󰓡 Swap      ",
      "keyColor": "green",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "{#90}┌──────────────────────── {#3}{#1}{#blue}Software{#}{#90} ────────────────────────┐",
    },
    {
      "type": "os",
      "key": "{#90}│{#}{#blue} \ue900 Distro    ",
      "keyColor": "blue",
    },
    {
      "type": "kernel    ",
      "key": "{#90}│{#}{#blue}  Kernel",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": "{#90}│{#}{#blue}  WinMan    ",
      "keyColor": "blue",
    },
    {
      "type": "de",
      "key": "{#90}│{#}{#blue}  DesktopEnv",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "{#90}│{#}{#blue}  Terminal  ",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "{#90}│{#}{#blue} 󰏖 Packages  ",
      "keyColor": "blue",
    },
    {
      "type": "wmtheme",
      "key": "{#90}│{#}{#blue} 󰉼 Theme     ",
      "keyColor": "blue",
    },
    {
      "type": "terminalfont",
      "key": "{#90}│{#}{#blue}  Font      ",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "{#90}┌────────────────── {#3}{#1}{#magenta}Age / Uptime / Update{#}{#90} ─────────────────┐",
    },
    {
      "type": "command",
      "key": "{#90}│{#}{#magenta} 󱦟 OS Age    ",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
    },
    {
      "type": "uptime",
      "key": "{#90}│{#}{#magenta} 󱫐 Uptime    ",
      "keyColor": "magenta",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────────┘",
    },
    "break",
  ],
}
