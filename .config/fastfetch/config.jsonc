{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fedora/branding/deathstar.txt",
    "color": { "1": "bright_black", "2": "white" },
    "padding": {
      "top": 3,
      "right": 0,
      "left": 0,
    },
  },
  "display": {
    "separator": " │ ",
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "  {#3}{#1}{#green}Hardware{#}",
    },
    {
      "type": "custom",
      "format": "┌─────────────┐ ┌─────────────────────────────────────────",
    },
    {
      "type": "host",
      "key": "{#}│{#green}  Host      {#}│",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "{#}│{#green}  CPU       {#}│",
      "showPeCoreCount": true,
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "{#}│{#green}  GPU       {#}│",
      "detectionMethod": "pci",
      "keyColor": "green",
    },
    {
      "type": "display",
      "key": "{#}│{#green} 󱄄 Display   {#}│",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": "{#}│{#green} 󰋊 Disk      {#}│",
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "{#}│{#green}  Memory    {#}│",
      "keyColor": "green",
    },
    {
      "type": "swap",
      "key": "{#}│{#green} 󰓡 Swap      {#}│",
      "keyColor": "green",
    },
    {
      "type": "custom",
      "format": "└─────────────┘ └─────────────────────────────────────────",
    },
    {
      "type": "custom",
      "format": "  {#3}{#1}{#blue}Software{#}",
    },
    {
      "type": "custom",
      "format": "┌─────────────┐ ┌─────────────────────────────────────────",
    },
    {
      "type": "os",
      "key": "{#}│{#blue} \ue900 Distro    {#}│",
      "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": "{#}│{#blue}  Kernel    {#}│",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": "{#}│{#blue}  WinManager{#}│",
      "keyColor": "blue",
    },
    {
      "type": "de",
      "key": "{#}│{#blue}  DesktopEnv{#}│",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "{#}│{#blue}  Terminal  {#}│",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "{#}│{#blue} 󰏖 Packages  {#}│",
      "keyColor": "blue",
    },
    {
      "type": "wmtheme",
      "key": "{#}│{#blue} 󰉼 Theme     {#}│",
      "keyColor": "blue",
    },
    {
      "type": "terminalfont",
      "key": "{#}│{#blue}  Font      {#}│",
      "keyColor": "blue",
    },
    {
      "type": "shell",
      "key": "{#}│{#blue}  Shell     {#}│",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "└─────────────┘ └─────────────────────────────────────────",
    },
    {
      "type": "custom",
      "format": "  {#3}{#1}{#magenta}Age / Uptime / Update{#}",
    },
    {
      "type": "custom",
      "format": "┌─────────────┐ ┌─────────────────────────────────────────",
    },
    {
      "type": "command",
      "key": "{#}│{#magenta} 󱦟 OS Age    {#}│",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
    },
    {
      "type": "uptime",
      "key": "{#}│{#magenta} 󱫐 Uptime    {#}│",
      "keyColor": "magenta",
    },
    {
      "type": "custom",
      "format": "└─────────────┘ └─────────────────────────────────────────",
    },
    "break",
  ],
}
